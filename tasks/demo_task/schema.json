{
    "task_name": "数据同步演示任务",
    "description": "定时将本地数据同步到远端服务器 (示例)",
    "parameters": [
        {
            "name": "target_server",
            "type": "choice",
            "options": [
                "Server_Alpha",
                "Server_Beta",
                "Server_Gamma"
            ],
            "label": "目标服务器"
        },
        {
            "name": "sync_path",
            "type": "string",
            "default": "/var/data",
            "label": "远端同步路径"
        },
        {
            "name": "timeout",
            "type": "int",
            "default": 30,
            "label": "超时时间(秒)"
        },
        {
            "name": "enable_log",
            "type": "bool",
            "default": true,
            "label": "记录执行日志"
        }
    ]
}
