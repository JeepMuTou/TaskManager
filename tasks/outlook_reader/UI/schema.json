{
    "task_name": "读取 Outlook 邮件并导出 Excel",
    "description": "读取本地 Outlook 指定邮箱全文件夹的邮件，判断收发，并增量记录到 Excel 表格中。",
    "parameters": [
        {
            "name": "target_account", 
            "type": "dynamic_editable_list", 
            "label": "监控邮箱账户"
        },
        {
            "name": "exclude_emails",
            "type": "dynamic_editable_list",
            "label": "排除邮箱列表"
        },
        {
            "name": "excel_row_count",
            "type": "dynamic_info",
            "label": "当前记录统计"
        },
        {
            "name": "past_hours",
            "type": "int",
            "default": 24,
            "label": "读取过去 N 小时内 (Hours)"
        },
        {
            "name": "max_emails", 
            "type": "int", 
            "default": 500, 
            "label": "单次最多读取封数"
        },
        {
            "name": "retention_hours",
            "type": "int",
            "default": 720,
            "label": "最大保存上限 (小时, 720=30天)"
        }
    ]
}
